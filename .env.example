# Copy to .env and adjust. Values here override config/*.yaml through the
# ${VAR} placeholders in those files.

APP_NAME=Omega
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=3000
LOG_LEVEL=info

# sqlite | postgres | mysql
# DB_SQLITE_PATH is the file for sqlite; DB_DATABASE is the name for postgres/mysql.
DB_CONNECTION=sqlite
DB_SQLITE_PATH=database/omega.db
DB_LOG_LEVEL=warn

# Only used by the postgres/mysql connections.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=omega
# DB_PASSWORD=

# Signs the JWTs. Generate one with: openssl rand -base64 48
# Booting without it is refused rather than falling back to a predictable key.
AUTH_SECRET=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h

# Public base URL, used to build each provider's OAuth callback.
APP_URL=http://localhost:3000

# OAuth providers. A provider whose id or secret is empty is simply skipped.
# Known: google, github, gitlab, microsoftonline, facebook, discord, linkedin
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Currency. Amounts are stored in the base currency and converted for display
# only; the rates come from the European Central Bank. Leave CURRENCY_AVAILABLE
# empty to offer the whole catalogue.
CURRENCY_BASE=EUR
# CURRENCY_AVAILABLE=EUR,USD,GBP

# Billing (Stripe). Off until BILLING_ENABLED=true, and enabling it without a
# webhook secret is refused at boot: an unsigned webhook is indistinguishable
# from a forged one.
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# BILLING_SUCCESS_URL=http://localhost:5173/billing/done
# BILLING_CANCEL_URL=http://localhost:5173/billing
# BILLING_PORTAL_RETURN_URL=http://localhost:5173/billing

# Copy to .env and adjust. Values here override config/*.yaml through the
# ${VAR} placeholders in those files.

APP_NAME=Omega
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=3000
LOG_LEVEL=info

# sqlite | postgres | mysql
# DB_SQLITE_PATH is the file for sqlite; DB_DATABASE is the name for postgres/mysql.
DB_CONNECTION=sqlite
DB_SQLITE_PATH=database/omega.db
DB_LOG_LEVEL=warn

# Only used by the postgres/mysql connections.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USERNAME=omega
# DB_PASSWORD=

# Signs the JWTs. Generate one with: openssl rand -base64 48
# Booting without it is refused rather than falling back to a predictable key,
# and so is a secret shorter than 32 bytes (outside APP_ENV=testing).
AUTH_SECRET=
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
# How long a rotated refresh token may be replayed without revoking its whole
# login family (two tabs refreshing at once). 0s is strict.
AUTH_REUSE_GRACE=0s

# Browsers get their tokens in HttpOnly cookies plus a readable omega_csrf
# cookie to echo in X-CSRF-Token. API clients send "X-Omega-Auth: bearer" on
# login to get the tokens in the body. With the API on another subdomain than
# the frontend, set the parent domain (example.com) so it can read omega_csrf.
AUTH_COOKIES=true
# AUTH_COOKIE_DOMAIN=
# Empty: Secure outside local and testing.
# AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=Lax

# The browser origins allowed to call the API with credentials. Never "*":
# with credentials on, a wildcard refuses to boot.
CORS_ORIGINS=http://localhost:5173
CORS_CREDENTIALS=true

# Behind a reverse proxy: the header carrying the client address, and the
# proxies allowed to set it (comma-separated addresses or CIDRs).
# APP_PROXY_HEADER=X-Real-IP
# APP_TRUSTED_PROXIES=10.0.0.0/8

# API consoles (/api/docs, /graphql, /api/openapi.json) and anonymous GraphQL
# introspection. Empty: public in local and testing, hidden elsewhere.
# API_DOCS_PUBLIC=
# API_PUBLIC_INTROSPECTION=

# /api/metrics and /api/stats. Prometheus sends METRICS_TOKEN as a bearer
# token (openssl rand -hex 32); admins may read them when METRICS_ADMINS=true.
# METRICS_TOKEN=
METRICS_ADMINS=true

# Public base URL, used to build each provider's OAuth callback.
APP_URL=http://localhost:3000

# OAuth providers. A provider whose id or secret is empty is simply skipped.
# Known: google, github, gitlab, microsoftonline, facebook, discord, linkedin
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Currency. Amounts are stored in the base currency and converted for display
# only; the rates come from the European Central Bank. Leave CURRENCY_AVAILABLE
# empty to offer the whole catalogue.
CURRENCY_BASE=EUR
# CURRENCY_AVAILABLE=EUR,USD,GBP

# Billing (Stripe). Off until BILLING_ENABLED=true, and enabling it without a
# webhook secret is refused at boot: an unsigned webhook is indistinguishable
# from a forged one.
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PRICE_TEAM=price_...
# BILLING_SUCCESS_URL=http://localhost:5173/billing/done
# BILLING_CANCEL_URL=http://localhost:5173/billing
# BILLING_PORTAL_RETURN_URL=http://localhost:5173/billing

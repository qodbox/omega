# Installs that are reproducible and run no third-party code.
#
# Dependencies may not run install scripts: that is where most supply-chain
# attacks start. The project's own scripts still run when called by name
# (npm run build). bun never runs them unless listed in trustedDependencies.
ignore-scripts=true
# Exact versions: what was reviewed is what installs. Commit the lockfile and
# install from it in CI (bun install --frozen-lockfile, npm ci).
save-exact=true
registry=https://registry.npmjs.org/
strict-ssl=true
fund=false

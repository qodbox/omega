package {{.Package}}

import (
	"github.com/gofiber/fiber/v2"

	"omega"
	"omega/app/models"
	presenter "omega/app/presenters/{{.Snake}}"
	request "omega/app/requests/{{.Snake}}"
	service "omega/app/services/{{.Snake}}"
	"omega/internal/validation"
)

type Controller struct {
	{{.Var}}s *service.Service
}

func NewController(svc *service.Service) *Controller {
	return &Controller{ {{.Var}}s: svc}
}

func ({{.Var}}c *Controller) Index(c *fiber.Ctx) error {
	records, err := {{.Var}}c.{{.Var}}s.All(c.UserContext())
	if err != nil {
		return err
	}
	return c.JSON(omega.Map{"data": presenter.NewViews(records)})
}

func ({{.Var}}c *Controller) Store(c *fiber.Ctx) error {
	body, err := validation.Bind[request.Payload](c)
	if err != nil {
		return err
	}

	record, err := {{.Var}}c.{{.Var}}s.Create(c.UserContext(), *body)
	if err != nil {
		return err
	}
	return c.Status(fiber.StatusCreated).JSON(omega.Map{"data": presenter.NewView(record)})
}

func ({{.Var}}c *Controller) Show(c *fiber.Ctx) error {
	record := omega.Bound[models.{{.Name}}](c)
	return c.JSON(omega.Map{"data": presenter.NewView(record)})
}

func ({{.Var}}c *Controller) Update(c *fiber.Ctx) error {
	record := omega.Bound[models.{{.Name}}](c)

	body, err := validation.Bind[request.Payload](c)
	if err != nil {
		return err
	}

	updated, err := {{.Var}}c.{{.Var}}s.Update(c.UserContext(), record, *body)
	if err != nil {
		return err
	}
	return c.JSON(omega.Map{"data": presenter.NewView(updated)})
}

func ({{.Var}}c *Controller) Destroy(c *fiber.Ctx) error {
	record := omega.Bound[models.{{.Name}}](c)

	if err := {{.Var}}c.{{.Var}}s.Delete(c.UserContext(), record); err != nil {
		return err
	}
	return c.SendStatus(fiber.StatusNoContent)
}
